# Copie para .env.local (git-ignorado) e preencha com valores reais.
# Nunca commite .env.local nem cole valores reais aqui.

# URL publica do backend (backend/, ver backend/.env.example) - o login do
# app e SO por CPF via SGU desde 2026-09-25 (admin fixo e usuarios de
# demonstracao removidos). Embutida no bundle em build time (Vite). Vazio =
# ninguem consegue entrar.
VITE_AUTH_API_URL=

# Connection strings do Neon usadas pelos scripts de ETL locais
# (etl/efetivo, etl/viaturas, etl/financas) — não usadas pelo app em si,
# só rodadas manualmente por quem executa a extração. Não precisam ir para
# a Vercel.
DATABASE_URL_EFETIVO=
DATABASE_URL_VIATURAS=
DATABASE_URL_FINANCAS=

# --- Data warehouse (etl/dw/) -------------------------------------------
# O DW e construido no Postgres interno. DATABASE_URL_DW aponta para o
# servidor (banco `postgres`); os scripts trocam o banco final para `dw`.
# Precisa de privilegio de CREATE DATABASE na primeira execucao.
# E o ADMINISTRADOR (aplica DDL, cria usuarios, configura o fdw).
DATABASE_URL_DW=

# Usuarios de login do DW (papeis da D7), criados por etl/dw/criar_usuarios.py,
# que grava estas tres linhas sozinho. Apontam direto para o banco `dw`.
#   _ETL  windmill_etl -> etl_writer  (flow do Windmill; publicar_dw.py manda esta)
#   _APP  app_backend  -> app_reader  (backend: so marts + schema app)
#   _BI   metabase_bi  -> bi_reader   (Metabase / Power BI: so marts)
DATABASE_URL_DW_ETL=
DATABASE_URL_DW_APP=
DATABASE_URL_DW_BI=

# Windmill (etl/windmill/publicar_dw.py)
WINDMILL_URL=
WINDMILL_EMAIL=
WINDMILL_PASSWORD=

# Fontes lidas pela camada raw. Duas credenciais alcancam quase tudo:
#   _SGP    10.193.0.16  -> ovrsgp (SGP) e ovresc (escala eletronica)
#   _OPS    10.193.0.20  -> mapa de forca, vacinacao, bombeiro civil
#                          (os scripts trocam o banco por fonte)
#   _FROTA  10.193.1.252:54329 -> frotas_production
# A Frota e lida DIRETO da origem, nao do Neon: o Neon e cache de
# aplicacao, com TRUNCATE a cada rodada e recorte de colunas.
DATABASE_URL_SGP=
DATABASE_URL_OPS=
DATABASE_URL_FROTA=

# Sistema de controle de reserva remunerada (Neon). E a unica fonte em que o
# Neon nao e cache de aplicacao: averbacao e afastamento-para-reserva nao
# existem em nenhuma outra fonte. Mesmo banco do DATABASE_URL_EFETIVO, com
# nome proprio porque o papel e outro.
DATABASE_URL_RESERVA=
