# Copie para backend/.env (local) ou backend/.env.production (compose de
# producao) e preencha com valores reais. Nunca commite o arquivo preenchido.

PORT=4000
NODE_ENV=production

# URL base do SGU (Sistema de Gestao de Usuarios) - servico de intranet do
# CBMPE, so alcancavel de dentro da rede interna/VPN. Sem protocolo/porta
# fixos aqui de proposito: nunca escreva o valor real neste arquivo.
SGU_URL=

# Chave de assinatura do JWT proprio deste backend (nao e do SGU). Gere com:
#   openssl rand -hex 32
# Nunca reaproveite a chave de outro projeto (ex.: forms-bm) nem a de dev.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Lista separada por virgula das origens autorizadas a chamar este backend
# (o front estatico do dw-cbmpe). Sem wildcard em producao.
CORS_ORIGIN=

# --- Ainda NAO usadas por este backend (ver backend/services/omeResolver.js) ---
# Resolucao CPF -> matricula -> OME depende de consultar o SGP e o DW - as
# connection strings sao as MESMAS ja usadas pelos scripts de etl/ (mesmo
# nome, ver .env.example na raiz). So preencha aqui quando o seam de
# omeResolver.js for implementado de fato.
# DATABASE_URL_SGP=
# DATABASE_URL_DW=
