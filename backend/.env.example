# Copie para backend/.env (local) ou backend/.env.production (compose de
# producao) e preencha com valores reais. Nunca commite o arquivo preenchido.

PORT=4000
NODE_ENV=production

# URL base do SGU (Sistema de Gestao de Usuarios) - servico de intranet do
# CBMPE, so alcancavel de dentro da rede interna/VPN. Sem protocolo/porta
# fixos aqui de proposito: nunca escreva o valor real neste arquivo.
SGU_URL=

# Chave de assinatura do JWT proprio deste backend (nao e do SGU). Gere com:
#   openssl rand -hex 32
# Nunca reaproveite a chave de outro projeto (ex.: forms-bm) nem a de dev.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Lista separada por virgula das origens autorizadas a chamar este backend
# (o front estatico do dw-cbmpe). Sem wildcard em producao.
CORS_ORIGIN=

# Credencial do login administrativo fixo (ver backend/services/authService.js
# loginAdmin e src/lib/authClient.js caminho 1). Segredo de SERVIDOR -
# diferente de VITE_ADMIN_USUARIO/VITE_ADMIN_SENHA (raiz do projeto), que vao
# em texto claro no bundle do front. Configure os dois pares com o MESMO
# valor no deploy, senao o admin fixo loga no front mas as rotas de escrita
# do organograma (POST/PUT/DELETE /organograma) devolvem 401/403.
ADMIN_USUARIO=adm
ADMIN_SENHA=adm

# Resolucao CPF -> matricula -> OME (backend/services/omeResolver.js) -
# mesmas connection strings ja usadas pelos scripts de etl/ (mesmo nome, ver
# .env.example na raiz). DATABASE_URL_DW aponta pro banco `postgres` do
# servidor (convencao de etl/dw/*.py) - config/db.js troca pro banco `dw`
# sozinho, onde vive core.fato_efetivo_diario.
DATABASE_URL_SGP=
DATABASE_URL_DW=
